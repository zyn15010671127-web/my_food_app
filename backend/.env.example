# 本地演示默认 SQLite，JWT 密钥留空时自动写入 data/runtime/.jwt_secret。
APP_ENV=development
DATABASE_URL=
JWT_SECRET_KEY=
SEED_DEMO_DATA=true
AUTO_CREATE_TABLES=true
ACCESS_TOKEN_MINUTES=30
RATE_LIMIT_ENABLED=true
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# 只有开启外部 AI、配置有效密钥与模型，并在请求中同意外传时才调用。
ENABLE_EXTERNAL_AI=false
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_CHAT_MODEL=
AI_VISION_MODEL=

# 百度标准菜品识别（单菜品）。密钥只放后端 .env，勿提交到 Git。
ENABLE_BAIDU_DISH=false
BAIDU_API_KEY=
BAIDU_SECRET_KEY=

# PostgreSQL 示例，请使用实际账号密码，密码中的特殊字符需要 URL 编码：
# DATABASE_URL=postgresql+psycopg://diet:your_password@127.0.0.1:5432/diet
