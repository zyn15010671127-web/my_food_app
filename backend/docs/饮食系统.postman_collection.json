{
  "info": {
    "name": "智能饮食系统后端演示流程",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "完整接口结构见openapi.json；此集合按演示步骤安排。图片和CSV请求需手动选择文件。"
  },
  "item": [
    {
      "name": "01 健康检查",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/health",
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "02 普通用户登录",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/auth/login",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"demo_user\",\n  \"password\": \"DemoPass123!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) pm.environment.set('token', pm.response.json().access_token);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 查看档案",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/profile/me",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "04 查询测试食物并记住编号",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/foods?q=测试食物",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if(pm.response.code===200 && pm.response.json().length) pm.environment.set('food_id', pm.response.json()[0].id);"
            ]
          }
        }
      ]
    },
    {
      "name": "05 新增饮食并记住记录编号",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/meal-records",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"food_id\": \"{{food_id}}\",\n  \"grams\": 150,\n  \"meal_type\": \"lunch\",\n  \"record_date\": \"{{record_date}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if(pm.response.code===201) pm.environment.set('record_id', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "06 查询当天记录",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/meal-records/me?record_date={{record_date}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "07 每日汇总",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/nutrition/daily?record_date={{record_date}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "08 每日目标",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/nutrition/target?record_date={{record_date}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "09 目标与摄入对比",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/nutrition/progress?record_date={{record_date}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "10 三套候选推荐",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/recommendations?record_date={{record_date}}&meal_type=lunch",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "11 修改刚创建的记录",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/meal-records/{{record_id}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"food_id\": \"{{food_id}}\",\n  \"grams\": 200,\n  \"meal_type\": \"dinner\",\n  \"record_date\": \"{{record_date}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "12 本地知识库问答",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/chat/messages",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"message\": \"蛋白质是什么\",\n  \"allow_external_processing\": false\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "13 规则编排推荐",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/agents/dispatch",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"message\": \"推荐午餐\",\n  \"record_date\": \"{{record_date}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "14 上传图片（先选择本地文件）",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{base_url}}/api/uploads/images",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": ""
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if(pm.response.code===201) pm.environment.set('image_id',pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "15 创建识别或手动降级任务",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/recognitions",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"image_id\": \"{{image_id}}\",\n  \"allow_external_processing\": false\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if(pm.response.code===201) pm.environment.set('recognition_id',pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "16 人工确认并保存",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/recognitions/{{recognition_id}}/confirm",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"meal_type\": \"lunch\",\n  \"record_date\": \"{{record_date}}\",\n  \"items\": [\n    {\n      \"food_id\": \"{{food_id}}\",\n      \"grams\": 100\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "17 个人数据导出",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/account/export",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "18 删除第05步的测试记录",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{base_url}}/api/meal-records/{{record_id}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "19 管理员登录",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/auth/login",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"AdminDemo123!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if(pm.response.code===200) pm.environment.set('admin_token',pm.response.json().access_token);"
            ]
          }
        }
      ]
    },
    {
      "name": "20 管理概览",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/admin/overview",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{admin_token}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "21 CSV导入（先选择模板文件）",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{base_url}}/api/admin/foods/import",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{admin_token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": ""
            }
          ]
        }
      }
    }
  ]
}